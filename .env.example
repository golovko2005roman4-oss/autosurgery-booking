# ── Supabase: публичные переменные (безопасны для браузера) ──
# Берутся из проекта Supabase: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Опционально: Telegram-уведомления администратору (пока НЕ подключены) ──
# Это СЕРВЕРНЫЕ переменные: НИКОГДА не добавлять в NEXT_PUBLIC_*.
# Модуль lib/telegram.ts пока заглушка; ключи пригодятся на следующем этапе.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ПРИМЕЧАНИЕ: приложению НЕ НУЖЕН service_role key — вся запись идёт через
# RPC (security definer) + RLS. Администратор работает через Supabase Auth.
